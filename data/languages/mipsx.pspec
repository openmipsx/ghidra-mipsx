<processor_spec>
  <properties>
    <property key="addressesDoNotAppearDirectlyInCode" value="true"/>
  </properties>
  <programcounter register="pc"/>
  <!-- base22/23/24/26 (code base word addresses for those registers) default
       to 0, meaning unknown; the Sipura loader sets them from the load directory. -->
  <context_data>
    <context_set space="ram">
      <set name="base22" val="0" description="Code base word address held in r22"/>
      <set name="base23" val="0" description="Code base word address held in r23"/>
      <set name="base24" val="0" description="Code base word address held in r24"/>
      <set name="base26" val="0" description="Code base word address held in r26"/>
    </context_set>
  </context_data>
  <register_data>
    <register name="contextreg" hidden="true"/>
    <register name="pcm4" group="Special"/>
    <register name="pcm1" group="Special"/>
  </register_data>
</processor_spec>
